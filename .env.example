# SpendSync has no AI keys. Claude (the customer's own plan) does all the AI work via MCP.

PORT=3000

# Secret path segment for the MCP URL: https://<your-domain>/mcp/<MCP_TOKEN>
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_TOKEN=change-me-to-a-long-random-string

# SQLite file location. On a host with a persistent disk, point this at the mounted path (e.g. /data/spendsync.db).
DB_PATH=./data/spendsync.db
